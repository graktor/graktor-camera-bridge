<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ZendoriaCameraBridge</AssemblyName>
    <RootNamespace>ZendoriaCameraBridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Published as a single self-contained executable per OS (see publish.ps1, which passes
         -r explicitly for each target): the branch PC that runs this has no reason to have the
         .NET runtime installed already. No RuntimeIdentifier is fixed here since the same
         project now builds for Windows, macOS, and Linux. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

</Project>
